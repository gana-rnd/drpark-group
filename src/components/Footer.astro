---
import { getLangFromUrl, useTranslations, localizePath } from '../i18n/utils';
import { group, companies, registrationsUrl } from '../data/group';
import Icon from './Icon.astro';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
---
<footer class="ftr">
  <div class="inner">
    <div class="footer-heading"><a class="brand" href={localizePath('/', lang)}><span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span><span class="name">Dr. Park<span class="brand-group">GROUP</span></span></a><a class="back-top" href="#main"><span>{t.common.backTop}</span><Icon name="down" size={18} /></a></div>
    <div class="top">
      <div class="brandcol"><p class="tag">{t.footer.tagline}</p><p class="aud">{t.footer.audience}</p></div>
      <div class="cols">
        <div><p class="h">{t.footer.companies}</p><ul>{companies.map((c) => <li><a href={c.url} rel="noopener">{c.name}<Icon name="diagonal" size={12} /></a></li>)}<li class="registration-link"><a href={registrationsUrl} rel="noopener">{t.cta.btn}<Icon name="diagonal" size={12} /></a></li></ul></div>
        <div><p class="h">{t.footer.site}</p><address>{t.footer.addr1}<br />{t.footer.addr2}<span class="building">{group.site.building}</span></address></div>
      </div>
    </div>
    <div class="base"><p class="note">{t.footer.note}</p><p class="copyright">&copy; {year} {group.name}</p></div>
  </div>
</footer>
<style>
  .ftr { background: #0b1827; color: var(--on-dark); padding: 64px var(--gutter) 32px; }
  .inner { max-width: var(--content-max); margin-inline: auto; }
  .footer-heading { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #ffffff20; padding-bottom: 36px; margin-bottom: 40px; }
  .brand { display: inline-flex; align-items: center; gap: 14px; }
  .name { font-size: 32px; font-weight: 500; letter-spacing: -.055em; line-height: 1; }
  .brand-group { display: block; margin-top: 8px; font: 8px var(--font-mono); letter-spacing: .4em; color: var(--accent-light); }
  .brand :global(.brand-mark) { width: 36px; height: 36px; background: transparent; border: 1px solid #ffffff35; }
  .back-top { display: inline-flex; gap: 18px; align-items: center; font-size: 10px; color: #ffffffb3; }
  .back-top :global(svg) { transform: rotate(180deg); }
  .back-top:hover { color: var(--accent-light); }
  .top { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 80px; align-items: start; }
  .tag { font-size: 23px; font-weight: 300; line-height: 1.6; letter-spacing: -.025em; max-width: 24ch; }
  .aud { margin-top: 24px; max-width: 38ch; font-size: 11px; line-height: 1.8; color: #ffffffa0; }
  .cols { display: grid; grid-template-columns: 1fr 1fr; gap: 50px; }
  .h { font: 9px var(--font-mono); letter-spacing: .12em; text-transform: uppercase; color: var(--accent-light); margin-bottom: 20px; }
  ul { list-style: none; display: grid; gap: 14px; }
  .cols a { display: flex; justify-content: space-between; align-items: center; gap: 14px; font-size: 12px; color: #ffffffcc; }
  .cols a :global(svg) { color: #ffffff80; flex: none; }
  .cols a:hover { color: var(--accent-light); }
  .registration-link { margin-top: 10px; padding-top: 18px; border-top: 1px solid #ffffff20; }
  .registration-link a { font-size: 10px; }
  address { font-style: normal; font-size: 11px; line-height: 1.9; color: #ffffffa0; }
  .building { display: block; margin-top: 10px; font-family: var(--font-mono); font-size: 10px; }
  .base { display: flex; justify-content: space-between; gap: 48px; align-items: flex-start; margin-top: 56px; padding-top: 24px; border-top: 1px solid #ffffff20; }
  .note { font-size: 10px; line-height: 1.9; color: #ffffff90; max-width: 90ch; }
  .copyright { font: 9px var(--font-mono); color: #ffffff90; white-space: nowrap; padding-top: 4px; }
  @media (max-width: 900px) { .top { grid-template-columns: 1fr; gap: 40px; } .cols { max-width: 700px; } .base { flex-direction: column; gap: 24px; } }
  @media (max-width: 480px) { .ftr { padding-top: 48px; } .name { font-size: 28px; } .back-top span { display: none; } .back-top { display: grid; place-items: center; width: 40px; height: 40px; border: 1px solid #ffffff30; } .cols { grid-template-columns: 1fr; gap: 32px; } .tag { font-size: 22px; } .base { margin-top: 40px; } }
</style>
