---
// 헤더 — 흰 바(히어로 위에 겹치지 않고 그 위에 얹힘, Figma v2). 워드마크 좌 · 앵커 내비 4 우 · 언어 전환기 · 모바일 햄버거.
// 로고 확정 전까지 워드마크는 잉크 사각형 + 대문자 자간 텍스트(임시).
import { getLangFromUrl, useTranslations, localizePath, stripLangFromPath, languages } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentPath = stripLangFromPath(Astro.url.pathname);
const home = localizePath('/', lang);

const nav = [
  { href: `${home}#founder`, label: t.nav.founder },
  { href: `${home}#makes`, label: t.nav.makes },
  { href: `${home}#companies`, label: t.nav.companies },
  { href: `${home}#contact`, label: t.nav.contact },
];
---

<header class="hdr">
  <div class="row">
    <a href={home} class="brand" aria-label="Dr. Park Group — home"><span class="mark" aria-hidden="true"></span><span class="name">Dr. Park Group</span></a>
    <div class="right">
      <nav id="site-nav" aria-label="Primary">
        <ul>
          {nav.map((i) => <li><a href={i.href}>{i.label}</a></li>)}
        </ul>
      </nav>
      <div class="lang-switch">
        <button class="lang-btn" type="button" aria-haspopup="true" aria-expanded="false" aria-label="Language">
          {languages.find((l) => l.code === lang)?.label}
          <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </button>
        <ul class="lang-menu" role="menu">
          {languages.map((l) => (
            <li role="none">
              <a role="menuitem" href={localizePath(currentPath, l.code)} class={l.code === lang ? 'active' : undefined} hreflang={l.code}>{l.name}</a>
            </li>
          ))}
        </ul>
      </div>
      <button class="menu-btn" type="button" aria-controls="site-nav" aria-expanded="false" aria-label={t.nav.menu}>
        <span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>
      </button>
    </div>
  </div>
</header>

<style>
  .hdr { background: var(--paper); border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 20; }
  .row { display: flex; align-items: center; justify-content: space-between; min-height: 64px; padding-inline: var(--gutter); }
  .brand { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); }
  .brand .mark { width: 20px; height: 20px; background: var(--ink); flex: none; }
  .brand .name { font-size: var(--text-sm); font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; white-space: nowrap; }
  .right { display: flex; align-items: center; gap: var(--s6); }
  nav ul { display: flex; gap: var(--s6); list-style: none; }
  nav a { font-size: var(--text-xs); font-weight: 500; color: var(--ink); padding-block: var(--s2); border-bottom: 1px solid transparent; transition: border-color var(--dur) var(--ease); }
  nav a:hover { border-bottom-color: var(--accent); }

  /* 언어 전환기 */
  .lang-switch { position: relative; z-index: 30; }
  .lang-btn {
    display: inline-flex; align-items: center; gap: 6px;
    font: inherit; font-size: var(--label); font-weight: 600; letter-spacing: 0.06em;
    color: var(--ink-2); background: none; border: 1px solid var(--line);
    border-radius: 999px; padding: 7px 14px; cursor: pointer;
    transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .lang-btn:hover { border-color: var(--accent); color: var(--accent); }
  .lang-menu {
    position: absolute; right: 0; top: calc(100% + 8px);
    list-style: none; background: #fff; border: 1px solid var(--line);
    border-radius: 6px; padding: 6px; min-width: 150px;
    box-shadow: 0 8px 24px rgba(14, 33, 57, 0.10);
    display: none; opacity: 0; transform: translateY(-6px);
    transition: opacity 200ms var(--ease-out-expo), transform 200ms var(--ease-out-expo);
  }
  .lang-switch.open .lang-menu { display: block; opacity: 1; transform: translateY(0); }
  .lang-menu a { display: block; padding: 8px 12px; font-size: var(--text-sm); color: var(--ink); border-radius: 4px; border: none; transition: background var(--dur) var(--ease); }
  .lang-menu a:hover { background: var(--paper-2); }
  .lang-menu a.active { color: var(--accent); font-weight: 600; }

  /* 햄버거 — 데스크톱에선 숨김 */
  .menu-btn { display: none; background: none; border: 0; cursor: pointer; padding: 10px; margin-right: -10px; }
  .menu-btn .bars { display: block; width: 22px; }
  .menu-btn .bars i { display: block; height: 2px; width: 100%; background: var(--ink); transition: transform 300ms var(--ease-out-expo), opacity 200ms var(--ease-out-expo); }
  .menu-btn .bars i + i { margin-top: 5px; }
  .hdr.nav-open .menu-btn .bars i:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .hdr.nav-open .menu-btn .bars i:nth-child(2) { opacity: 0; }
  .hdr.nav-open .menu-btn .bars i:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  @media (max-width: 1024px) {
    .row { min-height: 56px; }
    .menu-btn { display: inline-flex; }
    nav { position: absolute; left: 0; right: 0; top: 100%; display: none; background: #fff; border-bottom: 1px solid var(--line); box-shadow: 0 16px 32px rgba(14, 33, 57, 0.10); }
    .hdr.nav-open nav { display: block; }
    nav ul { flex-direction: column; gap: 0; padding: var(--s3) var(--gutter) var(--s5); }
    nav a { display: block; padding: var(--s3) 0; font-size: var(--text-base); }
  }
  @media (max-width: 480px) {
    .brand { gap: 8px; }
    .brand .mark { width: 18px; height: 18px; }
    .brand .name { font-size: var(--label); letter-spacing: 0.07em; }
    .right { gap: var(--s3); }
    .lang-btn { min-height: 44px; padding-inline: 12px; }
    .menu-btn { width: 44px; min-width: 44px; height: 44px; min-height: 44px; margin-right: 0; padding: 0; align-items: center; justify-content: center; }
  }
</style>

<script>
  const closeLang = () => {
    document.querySelectorAll('.lang-switch.open').forEach((el) => {
      el.classList.remove('open');
      el.querySelector('.lang-btn')?.setAttribute('aria-expanded', 'false');
    });
  };
  document.querySelectorAll('.lang-switch').forEach((el) => {
    const btn = el.querySelector('.lang-btn');
    btn?.addEventListener('click', (e) => {
      e.stopPropagation();
      closeNav();
      const open = el.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(open));
    });
  });
  document.addEventListener('click', closeLang);

  const hdr = document.querySelector('.hdr');
  const menuBtn = document.querySelector('.menu-btn');
  const closeNav = () => {
    if (!hdr?.classList.contains('nav-open')) return;
    hdr.classList.remove('nav-open');
    menuBtn?.setAttribute('aria-expanded', 'false');
  };
  menuBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    closeLang();
    const open = hdr?.classList.toggle('nav-open') ?? false;
    menuBtn.setAttribute('aria-expanded', String(open));
  });
  document.addEventListener('click', (e) => {
    if (hdr && e.target instanceof Node && !hdr.contains(e.target)) closeNav();
  });
  document.querySelectorAll('#site-nav a').forEach((a) => a.addEventListener('click', closeNav));
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const navWasOpen = hdr?.classList.contains('nav-open');
    closeLang();
    closeNav();
    if (navWasOpen && menuBtn instanceof HTMLElement) menuBtn.focus();
  });
</script>
