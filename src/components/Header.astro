---
import { getLangFromUrl, useTranslations, localizePath, stripLangFromPath, languages } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentPath = stripLangFromPath(Astro.url.pathname);
const home = localizePath('/', lang);
const nav = [
  { id: 'founder', label: t.nav.founder },
  { id: 'makes', label: t.nav.makes },
  { id: 'companies', label: t.nav.companies },
  { id: 'contact', label: t.nav.contact },
];
---
<header class="hdr">
  <div class="row">
    <a href={home} class="brand" aria-label={`${t.common.home} — Dr. Park Group`}><span class="name">Dr. Park<span class="brand-group">Group</span></span></a>
    <div class="right">
      <nav id="site-nav" aria-label={t.nav.primary}><ul>{nav.map((item, i) => <li><a href={`${home}#${item.id}`} data-section={item.id}><span class="nav-number" aria-hidden="true">0{i + 1}</span>{item.label}</a></li>)}</ul></nav>
      <div class="lang-switch">
        <button class="lang-btn" type="button" aria-controls="language-options" aria-expanded="false" aria-label={t.common.language}>{languages.find((l) => l.code === lang)?.label}<svg width="8" height="5" viewBox="0 0 10 6" fill="none" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" /></svg></button>
        <ul class="lang-menu" id="language-options">{languages.map((l) => <li><a href={localizePath(currentPath, l.code)} class={l.code === lang ? 'active' : undefined} hreflang={l.code} lang={l.code} aria-current={l.code === lang ? 'true' : undefined}>{l.name}<span>{l.label}</span></a></li>)}</ul>
      </div>
      <button class="menu-btn" type="button" aria-controls="site-nav" aria-expanded="false" aria-label={t.nav.menu}><span class="bars" aria-hidden="true"><i></i><i></i></span></button>
    </div>
  </div>

</header>
<style>
  .hdr { background: var(--paper); border-bottom: 2px solid var(--ink); position: sticky; top: 0; z-index: 20; }
  .row { display: flex; align-items: center; justify-content: space-between; min-height: 88px; padding-inline: var(--gutter); gap: 24px; transition: min-height 240ms; }
  .hdr.is-scrolled .row { min-height: 72px; }
  .brand { display: inline-flex; align-items: center; gap: 14px; color: var(--ink); }
  .name { font-size: 30px; font-weight: 700; letter-spacing: -.055em; line-height: 1; white-space: nowrap; }
  .brand-group { display: inline; margin-left: 7px; font: inherit; letter-spacing: inherit; }
  .right { display: flex; align-items: center; gap: 32px; }
  nav ul { display: flex; gap: 34px; list-style: none; }
  nav a { position: relative; font-size: 13px; font-weight: 600; color: var(--ink); padding-block: 14px; display: inline-flex; gap: 8px; transition: color 200ms; }
  nav a::after { content: ''; position: absolute; bottom: 4px; left: 0; right: 0; height: 1px; background: var(--accent); transform: scaleX(0); transform-origin: left; transition: transform 200ms; }
  nav a:hover, nav a[aria-current="location"] { color: var(--accent-2); }
  nav a:hover::after, nav a[aria-current="location"]::after { transform: scaleX(1); }
  .nav-number { display: none; }
  .lang-switch { position: relative; }
  .lang-btn { display: flex; align-items: center; gap: 9px; background: none; border: 0; border-left: 1px solid var(--line); color: var(--ink); font: 10px var(--font-mono); cursor: pointer; padding: 12px 0 12px 24px; min-height: 44px; }
  .lang-btn:hover { color: var(--accent-2); }
  .lang-menu { position: absolute; right: 0; top: calc(100% + 12px); min-width: 180px; list-style: none; background: var(--paper); border: 1px solid var(--line); padding: 8px; box-shadow: 0 16px 36px #16222c18; display: none; }
  .lang-switch.open .lang-menu { display: block; }
  .lang-menu a { display: flex; justify-content: space-between; gap: 30px; padding: 14px 12px; font-size: 12px; }
  .lang-menu a span { color: var(--ink-3); font: 10px var(--font-mono); }
  .lang-menu a:hover { background: var(--paper-2); }
  .lang-menu a.active { color: var(--accent-2); }
  .menu-btn { display: none; width: 44px; height: 44px; background: none; border: 1px solid var(--line); cursor: pointer; align-items: center; justify-content: center; }
  .bars { width: 18px; display: block; }
  .bars i { display: block; height: 1px; background: var(--ink); transition: transform 200ms; }
  .bars i + i { margin-top: 6px; }
  .nav-open .bars i:first-child { transform: translateY(3.5px) rotate(45deg); }
  .nav-open .bars i:last-child { transform: translateY(-3.5px) rotate(-45deg); }
  @media (max-width: 1024px) {
    .row, .hdr.is-scrolled .row { min-height: 76px; }
    .menu-btn { display: flex; }
    .right { gap: 20px; }
    nav { display: none; position: absolute; left: 0; right: 0; top: 100%; background: var(--paper); border-bottom: 1px solid var(--line); box-shadow: 0 20px 40px #16222c15; }
    .nav-open nav { display: block; }
    nav ul { display: block; padding: 16px var(--gutter) 24px; }
    nav li + li { border-top: 1px solid var(--line); }
    nav a { display: flex; align-items: center; gap: 24px; padding: 20px 0; font-size: 18px; }
    .nav-number { display: block; font: 10px var(--font-mono); color: var(--accent); }
    nav a::after { display: none; }
    .lang-btn { padding-left: 0; border-left: 0; }
  }
  @media (max-width: 480px) { .row, .hdr.is-scrolled .row { min-height: 72px; gap: 12px; } .brand { gap: 10px; } .name { font-size: 22px; } .brand-group { font-size: inherit; } .right { gap: 10px; } .lang-btn { gap: 5px; }  }
</style>
<script>
  const hdr = document.querySelector('.hdr');
  const menuBtn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const langSwitch = document.querySelector('.lang-switch');
  const langBtn = document.querySelector<HTMLButtonElement>('.lang-btn');
  const closeLang = () => { langSwitch?.classList.remove('open'); langBtn?.setAttribute('aria-expanded', 'false'); };
  const closeNav = () => { hdr?.classList.remove('nav-open'); menuBtn?.setAttribute('aria-expanded', 'false'); };
  langBtn?.addEventListener('click', () => {
    closeNav();
    const open = langSwitch?.classList.toggle('open') ?? false;
    langBtn.setAttribute('aria-expanded', String(open));
    document.querySelectorAll<HTMLAnchorElement>('.lang-menu a').forEach((a) => { a.hash = window.location.hash; });
  });
  menuBtn?.addEventListener('click', () => { closeLang(); const open = hdr?.classList.toggle('nav-open') ?? false; menuBtn.setAttribute('aria-expanded', String(open)); });
  document.addEventListener('click', (e) => { if (e.target instanceof Node && !langSwitch?.contains(e.target)) closeLang(); if (e.target instanceof Node && !hdr?.contains(e.target)) closeNav(); });
  document.querySelectorAll('#site-nav a').forEach((a) => a.addEventListener('click', closeNav));
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const navOpen = hdr?.classList.contains('nav-open');
    const langOpen = langSwitch?.classList.contains('open');
    closeLang(); closeNav();
    if (navOpen) menuBtn?.focus(); else if (langOpen) langBtn?.focus();
  });
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-section]');
  let queued = false;
  const updateScroll = () => {
    let active = '';
    links.forEach((link) => { const id = link.dataset.section; if (id && (document.getElementById(id)?.getBoundingClientRect().top ?? Infinity) <= 180) active = id; });
    links.forEach((link) => { if (link.dataset.section === active) link.setAttribute('aria-current', 'location'); else link.removeAttribute('aria-current'); });
    queued = false;
  };
  window.addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(updateScroll); } }, { passive: true });
  window.addEventListener('resize', updateScroll);
  updateScroll();
</script>
