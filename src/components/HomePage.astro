---
import { companies, byId, layers, stats, registrationsUrl, filmUrl } from '../data/group';
import { getLangFromUrl, useTranslations, tpl } from '../i18n/utils';
import type { CompanyStrings } from '../i18n/en';
import Icon from './Icon.astro';
import '../styles/home.css';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const items = t.companies.items as Record<string, CompanyStrings>;
const cs = (id: string) => items[id];
const keyStats = [2, 3].map((i) => ({ n: stats[i].n, count: stats[i].count, label: t.record.stats[i] }));
const heroTail = t.hero.title2.split(', ').map((line, i, all) => i < all.length - 1 ? line + ',' : line);
---
<div class="gateway">
  <section class="hero" id="top" aria-labelledby="hero-title">
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="hero-grid">
      <div class="hero-location hero-fade d1">{t.hero.eyebrow}</div>
      <div class="hero-copy">
        <h1 class="hero-title" id="hero-title">
          <span class="hero-line"><span>{t.hero.title1}</span></span>
          {heroTail.map((line) => <span class="hero-line"><span>{line}</span></span>)}
        </h1>
        <a href="#founder" class="scroll-link hero-fade d2"><Icon name="down" size={22} />{t.common.scroll}</a>
      </div>
      <div class="hero-intro hero-fade d2">
        <p>{t.hero.sub}</p>
        <a class="bracket on-dark" href="#companies"><span>{t.nav.companies}</span><Icon name="arrow" /></a>
      </div>
      <div class="hero-directory hero-fade d2">
        {companies.map((c) => (
          <a href={`#${c.id}`}><span>{c.name}<small>{cs(c.id).field}</small></span><Icon name="diagonal" size={18} /></a>
        ))}
      </div>
    </div>
  </section>

  <section class="panel paper right founder" id="founder" aria-labelledby="founder-title">
    <div class="section-label"><p class="eyebrow"><span>01</span>{t.founder.eyebrow}</p><span class="section-rule"></span><span class="section-meta">2014 — 2026</span></div>
    <div class="grid two" data-reveal>
      <div class="copy">
        <h2 id="founder-title">{t.founder.title}</h2>
        <p class="founder-name">{t.common.founder}</p>
        <p>{t.founder.p1}</p>
        <p>{t.founder.p2}</p>
      </div>
      <div class="facts">
        <div class="stats2">
          {keyStats.map((s) => (
            <div class="stat">
              {s.count ? <div class="n" data-count={s.n}>{s.n}</div> : <div class="n">{s.n}</div>}
              <div class="l">{s.label}</div>
            </div>
          ))}
        </div>
        <div class="timeline-heading"><p class="eyebrow">{t.founder.timelineTitle}</p><Icon name="down" size={16} /></div>
        <ol class="timeline">
          {t.founder.timeline.map((e, i) => (
            <li class={i === t.founder.timeline.length - 1 ? 'target-year' : undefined}><span class="y">{e.y}</span><span class="timeline-dot" aria-hidden="true"></span><span class="d">{e.t}</span></li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="panel glass left makes" id="makes" aria-labelledby="makes-title">
    <div class="section-label"><p class="eyebrow"><span>02</span>{t.makes.eyebrow}</p><span class="section-rule"></span></div>
    <div class="grid two head" data-reveal><h2 id="makes-title">{t.makes.title}</h2><p class="lead">{t.makes.lead}</p></div>
    <div class="layers">
      {layers.map((l, i) => (
        <article class="layer" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
          <div class="layer-top"><span class="no">{l.no}</span></div>
          <h3>{t.makes.layers[i].name}</h3>
          <p>{t.makes.layers[i].what}</p>
          <div class="layer-bottom"><p class:list={['tense', { 'is-target': i === 2 }]}><span class="status-dot" aria-hidden="true"></span>{t.makes.layers[i].tense}</p><p class="by">{t.makes.madeBy}<br />{l.by.map((id) => byId[id].name).join(' · ')}</p></div>
        </article>
      ))}
    </div>
    <p class="note"><span aria-hidden="true">*</span>{t.makes.note}</p>
  </section>

  <section class="panel paper right companies" id="companies" aria-labelledby="companies-title">
    <div class="section-label"><p class="eyebrow"><span>03</span>{t.companies.eyebrow}</p><span class="section-rule"></span></div>
    <div class="grid two head" data-reveal><h2 id="companies-title">{t.companies.title}</h2><p class="lead">{t.companies.lead}</p></div>
    <div class="cards">
      {companies.map((c, i) => (
        <article class={`card card-${c.id}`} id={c.id} data-reveal style={`--reveal-delay: ${i * 80}ms`}>
          <div class="company-identity">
            <div class="card-top"><p class="eyebrow">{cs(c.id).field}</p></div>
            <h3>{c.name}</h3>
            <p class="tag">{cs(c.id).tagline}</p>
          </div>
          <div class="card-status"><span class="small-label">{t.companies.statusLabel}</span><p class="status">{cs(c.id).status}</p></div>
          <div class="company-actions">
          <details class="records">
            <summary><span>{t.companies.credentialsLabel}</span><span class="records-action"><Icon name="plus" size={16} /></span></summary>
            <ul class="creds">{cs(c.id).credentials.map((x) => <li>{x}</li>)}</ul>
          </details>
          <a class="company-link" href={c.url} rel="noopener"><span>{tpl(t.common.visit, { name: c.name })}</span><Icon name="diagonal" size={22} /></a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="film" id="film" aria-labelledby="film-title">
    <div class="film-set" data-reveal>
      <div class="copy">
        <p class="eyebrow on-dark"><span class="film-number">04</span>{t.film.eyebrow}</p>
        <h2 id="film-title">{t.film.title}</h2><p>{t.film.body}</p>
        {filmUrl ? <a class="bracket on-dark" href={filmUrl} rel="noopener"><span>{t.film.watch}</span><Icon name="diagonal" /></a> : <p class="film-pending"><span class="status-dot" aria-hidden="true"></span>{t.film.pending}</p>}
      </div>
      <figure class="thumb">
        <button class="frame" type="button" data-open-facility aria-label={t.film.enlarge}><img src="/images/film-thumb.webp" width="1280" height="720" alt={t.film.alt} loading="lazy" /><span class="photo-enlarge"><Icon name="plus" size={18} /><span>{t.film.enlarge}</span></span></button>
        <figcaption><span>{t.film.caption}</span></figcaption>
      </figure>
    </div>
  </section>
  <dialog class="facility-dialog" aria-label={t.film.enlarge}>
    <button class="dialog-close" type="button" aria-label={t.film.close}><Icon name="close" size={24} /></button>
    <img src="/images/film-thumb.webp" width="1280" height="720" alt={t.film.alt} /><p>{t.film.caption}</p>
  </dialog>

  <section class="panel glass left contact" id="contact" aria-labelledby="contact-title">
    <div class="section-label"><p class="eyebrow"><span>05</span>{t.contact.eyebrow}</p><span class="section-rule"></span></div>
    <div class="grid two head" data-reveal><h2 id="contact-title">{t.contact.title}</h2><p class="lead">{t.contact.lead}</p></div>
    <div class="table-wrap plain" data-reveal>
      <table class="route"><thead><tr><th scope="col">{t.contact.thCompany}</th><th scope="col">{t.contact.thFor}</th><th scope="col">{t.contact.thChannel}</th></tr></thead><tbody>
        {companies.map((c) => (
          <tr><th scope="row" class="co">{c.name}</th><td class="for">{cs(c.id).contactLabel}</td><td class="ch">
            {c.tel && <a class="mono" href={`tel:${c.tel.replace(/[^+\d]/g, '')}`}>{c.tel}</a>}
            {c.email && <a class="mono" href={'mailto:' + c.email}>{c.email}</a>}
            <a class="go" href={c.contactUrl} rel="noopener"><span>{tpl(t.common.contactCo, { name: c.name })}</span><Icon name="diagonal" size={16} /></a>
          </td></tr>
        ))}
      </tbody></table>
    </div>
    <div class="cta-row"><div><p class="cta-title">{t.cta.title}</p><p>{t.cta.body}</p></div><a class="bracket on-dark" href={registrationsUrl} rel="noopener"><span>{t.cta.btn}</span><Icon name="arrow" /></a></div>
  </section>
</div>

<script>
  const facilityDialog = document.querySelector<HTMLDialogElement>('.facility-dialog');
  document.querySelector('[data-open-facility]')?.addEventListener('click', () => facilityDialog?.showModal());
  facilityDialog?.querySelector('.dialog-close')?.addEventListener('click', () => facilityDialog.close());
  facilityDialog?.addEventListener('click', (event) => {
    const bounds = facilityDialog.getBoundingClientRect();
    if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) facilityDialog.close();
  });
</script>
