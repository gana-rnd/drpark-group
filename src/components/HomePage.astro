---
// 게이트웨이 홈 본문 — index.astro(EN)와 ko/index.astro(KO)가 같은 컴포넌트를 렌더한다.
// 구성: 히어로(세 회사 트립틱) → 01 창업자·연혁 → 02 무엇을 만드는가(세 층·시제) → 03 숫자(다크) → 04 세 회사 → 05 한 부지 → 06 문의 라우팅 → CTA
import PhotoSlot from './PhotoSlot.astro';
import { companies, byId, layers, stats, registrationsUrl } from '../data/group';
import { getLangFromUrl, useTranslations, tpl } from '../i18n/utils';
import type { CompanyStrings } from '../i18n/en';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const items = t.companies.items as Record<string, CompanyStrings>;
const cs = (id: string) => items[id];
---

<!-- 히어로 — 네이비 단색(사진 없음). 헤드라인 + 한 줄 + 세 회사 트립틱 -->
<section class="hero">
  <div class="container hero-inner">
    <p class="hero-eyebrow hero-fade d1">{t.hero.eyebrow}</p>
    <h1 class="hero-title">
      <span class="hero-line"><span>{t.hero.title1}</span></span>
      <span class="hero-line"><span>{t.hero.title2}</span></span>
    </h1>
    <p class="hero-sub hero-fade d2">{t.hero.sub}</p>
  </div>
  <div class="container hero-tri hero-fade d3">
    <ul>
      {companies.map((c, i) => (
        <li>
          <a href={c.url} rel="noopener">
            <span class="tno">{String(i + 1).padStart(2, '0')}</span>
            <span class="tname">{c.name}</span>
            <span class="tfield">{cs(c.id).field}</span>
            <span class="tline">{cs(c.id).tagline}</span>
            <span class="tgo">{tpl(t.common.visit, { name: c.name })} <span class="arr">→</span></span>
          </a>
        </li>
      ))}
    </ul>
  </div>
  <div class="scroll-indicator on-hero" aria-hidden="true"><span class="label">{t.common.scroll}</span></div>
</section>

<!-- 01 창업자 — 좌 문단 / 우 포트레이트 슬롯, 아래 연혁 -->
<section class="container section" id="founder">
  <div class="split founder">
    <div class="text" data-reveal-stagger>
      <p class="eyebrow"><span class="no">01</span> {t.founder.eyebrow}</p>
      <h2>{t.founder.title}</h2>
      <p>{t.founder.p1}</p>
      <p>{t.founder.p2}</p>
    </div>
    <div class="portrait" data-reveal="right">
      <PhotoSlot note={t.founder.photoNote} ratio="4 / 5" />
    </div>
  </div>
  <div class="timeline" data-reveal-stagger>
    <p class="tl-title">{t.founder.timelineTitle}</p>
    <ol>
      {t.founder.timeline.map((e) => (
        <li>
          <span class="y mono">{e.y}</span>
          <span class="d">{e.t}</span>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- 02 무엇을 만드는가 — 세 층, 층별 시제. 세 층을 하나의 주어로 잇지 않는다. -->
<section class="section alt" id="makes">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow"><span class="no">02</span> {t.makes.eyebrow}</p>
      <h2>{t.makes.title}</h2>
      <p class="lead">{t.makes.lead}</p>
    </div>
    <div class="ladder" data-reveal-stagger>
      {layers.map((l, i) => (
        <div class="rung">
          <span class="rno mono">{l.no}</span>
          <h3>{t.makes.layers[i].name}</h3>
          <p>{t.makes.layers[i].what}</p>
          <p class="tense">{t.makes.layers[i].tense}</p>
          <p class="by">{t.makes.madeBy} · {l.by.map((id) => byId[id].name).join(' · ')}</p>
        </div>
      ))}
    </div>
    <p class="callout makes-note" data-reveal>{t.makes.note}</p>
  </div>
</section>

<!-- 03 숫자 — 다크, 카운트업 -->
<section class="dark section" id="record">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow"><span class="no">03</span> {t.record.eyebrow}</p>
      <h2>{t.record.title}</h2>
    </div>
    <div class="stats" data-reveal>
      {stats.map((s, i) => (
        <div class="stat">
          {s.count ? <div class="n" data-count={s.n}>{s.n}</div> : <div class="n">{s.n}</div>}
          <div class="l">{t.record.stats[i]}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- 04 세 회사 — 카드 3, 자격은 각 회사 이름 아래 -->
<section class="container section" id="companies">
  <div class="section-head" data-reveal>
    <p class="eyebrow"><span class="no">04</span> {t.companies.eyebrow}</p>
    <h2>{t.companies.title}</h2>
    <p class="lead">{t.companies.lead}</p>
  </div>
  <div class="cards co" data-reveal-stagger>
    {companies.map((c) => (
      <article class="card">
        <p class="who">{cs(c.id).field}</p>
        <h3>{c.name}</h3>
        <p>{cs(c.id).makes}</p>
        <dl class="facts">
          <dt>{t.companies.servesLabel}</dt><dd>{cs(c.id).serves}</dd>
          <dt>{t.companies.statusLabel}</dt><dd>{cs(c.id).status}</dd>
          <dt>{t.companies.credentialsLabel}</dt>
          <dd><ul class="creds">{cs(c.id).credentials.map((x) => <li>{x}</li>)}</ul></dd>
        </dl>
        <a class="link" href={c.url} rel="noopener">{tpl(t.common.visit, { name: c.name })} <span class="arr">→</span></a>
      </article>
    ))}
  </div>
</section>

<!-- 05 한 부지 -->
<section class="container section tight" id="site">
  <div class="section-head" data-reveal>
    <p class="eyebrow"><span class="no">05</span> {t.site.eyebrow}</p>
    <h2>{t.site.title}</h2>
  </div>
  <ul class="kv" data-reveal-stagger>
    <li><span class="k">{t.site.addressK}</span><span>{t.site.addressV}</span></li>
    <li><span class="k">{t.site.founderK}</span><span>{t.site.founderV}</span></li>
    <li><span class="k">{t.site.licenceK}</span><span>{t.site.licenceV}</span></li>
    <li><span class="k">{t.site.facilityK}</span><span>{t.site.facilityV}</span></li>
  </ul>
</section>

<!-- 06 문의 라우팅 — 그룹 채널 없음. 회사별 법인 채널만 -->
<section class="container section tight" id="contact">
  <div class="section-head" data-reveal>
    <p class="eyebrow"><span class="no">06</span> {t.contact.eyebrow}</p>
    <h2>{t.contact.title}</h2>
    <p class="lead">{t.contact.lead}</p>
  </div>
  <div class="table-wrap" data-reveal>
    <table class="table stack">
      <thead><tr><th>{t.contact.thCompany}</th><th>{t.contact.thFor}</th><th>{t.contact.thChannel}</th><th></th></tr></thead>
      <tbody>
        {companies.map((c) => (
          <tr>
            <td><b>{c.name}</b></td>
            <td class="muted">{cs(c.id).contactLabel}</td>
            <td>
              {c.tel && <span class="mono">{c.tel}</span>}
              {c.email && <a class="mono" href={'mailto:' + c.email}>{c.email}</a>}
            </td>
            <td><a class="link" href={c.contactUrl} rel="noopener">{tpl(t.common.contactCo, { name: c.name })} <span class="arr">→</span></a></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<!-- CTA -->
<section class="cta">
  <div class="container row" data-reveal>
    <div>
      <h2>{t.cta.title}</h2>
      <p>{t.cta.body}</p>
    </div>
    <a class="btn on-dark" href={registrationsUrl} rel="noopener">{t.cta.btn}</a>
  </div>
</section>

<style>
  /* ── 히어로 — GANA R&D 홈과 같은 값, 사진 대신 네이비 ── */
  .hero { position: relative; min-height: min(92vh, 980px); display: flex; flex-direction: column; justify-content: flex-end; color: #fff; background: var(--navy); overflow: hidden; }
  .hero-inner { position: relative; width: 100%; max-width: var(--content-max); padding-top: var(--s10); padding-bottom: var(--s7); }
  .hero-eyebrow { font-size: var(--text-sm); letter-spacing: 0.14em; text-transform: uppercase; color: rgba(255, 255, 255, 0.72); margin-bottom: var(--s5); }
  .hero-title { font-size: var(--text-display); font-weight: 700; letter-spacing: -0.025em; line-height: 1.04; color: #fff; max-width: 14ch; }
  .hero-sub { margin-top: var(--s5); max-width: 56ch; font-size: var(--text-lg); color: rgba(255, 255, 255, 0.82); }
  :global(html[lang="ko"]) .hero-title { max-width: 16ch; }

  /* 트립틱 — 세 회사가 히어로 바닥에 세 기둥으로 선다 */
  .hero-tri { position: relative; width: 100%; max-width: var(--content-max); padding-bottom: var(--s8); }
  .hero-tri ul { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid rgba(255, 255, 255, 0.22); }
  .hero-tri li + li { border-left: 1px solid rgba(255, 255, 255, 0.14); }
  .hero-tri a { display: grid; grid-template-rows: auto auto auto 1fr auto; gap: var(--s2); height: 100%; padding: var(--s6) var(--s6) var(--s6) 0; transition: background 300ms var(--ease-out-expo); }
  .hero-tri li + li a { padding-left: var(--s6); }
  .hero-tri a:hover { background: rgba(255, 255, 255, 0.04); }
  .hero-tri .tno { font-family: var(--font-mono); font-size: var(--text-sm); color: rgba(255, 255, 255, 0.5); letter-spacing: 0.08em; }
  .hero-tri .tname { font-size: var(--text-xl); font-weight: 700; letter-spacing: -0.015em; color: #fff; margin-top: var(--s3); }
  .hero-tri .tfield { font-size: var(--text-xs); letter-spacing: 0.08em; text-transform: uppercase; color: rgba(255, 255, 255, 0.55); }
  .hero-tri .tline { font-size: var(--text-sm); color: rgba(255, 255, 255, 0.78); margin-top: var(--s2); max-width: 30ch; }
  .hero-tri .tgo { font-size: var(--text-sm); font-weight: 600; color: #fff; display: inline-flex; align-items: center; gap: 6px; margin-top: var(--s4); }
  .hero-tri .tgo .arr { display: inline-block; transition: transform 350ms var(--ease-out-expo); }
  .hero-tri a:hover .tgo .arr { transform: translateX(5px); }
  .scroll-indicator.on-hero { left: auto; right: var(--gutter); transform: none; bottom: 24px; background: rgba(255,255,255,0.25); }
  .scroll-indicator.on-hero::after { background: #fff; }
  .scroll-indicator.on-hero .label { color: rgba(255,255,255,0.7); }
  @media (max-width: 900px) {
    .hero { min-height: 0; }
    .hero-inner { padding-top: var(--s9); }
    .hero-tri ul { grid-template-columns: 1fr; }
    .hero-tri li + li { border-left: 0; border-top: 1px solid rgba(255, 255, 255, 0.14); }
    .hero-tri li + li a { padding-left: 0; }
    .hero-tri a { padding-right: 0; }
    .scroll-indicator.on-hero { display: none; }
  }

  /* ── 01 창업자 ── */
  .split.founder { grid-template-columns: minmax(0, 6fr) minmax(0, 4fr); align-items: start; }
  .portrait { max-width: 440px; justify-self: end; width: 100%; }
  @media (max-width: 900px) { .portrait { justify-self: start; max-width: 360px; } }
  .timeline { margin-top: var(--s8); border-top: 1px solid var(--ink); padding-top: var(--s5); }
  .tl-title { font-size: var(--text-sm); color: var(--ink-3); margin-bottom: var(--s5); }
  .timeline ol { list-style: none; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: var(--s6); }
  .timeline li { display: grid; gap: var(--s2); border-left: 1px solid var(--line); padding-left: var(--s4); }
  .timeline .y { color: var(--accent); font-size: var(--text-lg); letter-spacing: 0.02em; }
  .timeline .d { font-size: var(--text-sm); color: var(--ink-2); }
  @media (max-width: 1024px) { .timeline ol { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .timeline ol { grid-template-columns: 1fr; } }

  /* ── 02 세 층 사다리 — 가로 3열, 큰 숫자 ── */
  .ladder { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s7); }
  .rung { border-top: 1px solid var(--ink); padding-top: var(--s5); display: flex; flex-direction: column; gap: var(--s2); }
  .rung .rno { font-size: clamp(2.5rem, 4vw, 3.5rem); line-height: 1; color: var(--accent); letter-spacing: -0.02em; margin-bottom: var(--s3); }
  .rung h3 { font-size: var(--text-xl); }
  .rung p { font-size: var(--text-sm); color: var(--ink); }
  .rung .tense { color: var(--ink-2); font-weight: 600; margin-top: var(--s1); }
  .rung .by { color: var(--ink-3); margin-top: var(--s2); font-size: var(--text-xs); letter-spacing: 0.04em; }
  .makes-note { margin-top: var(--s7); max-width: 72ch; background: #fff; border: 1px solid var(--line); }
  @media (max-width: 900px) { .ladder { grid-template-columns: 1fr; } }

  /* ── 04 회사 카드 — 라벨-값 + 기록 목록 ── */
  .cards.co .card { gap: var(--s4); }
  .facts { display: grid; grid-template-columns: 88px 1fr; gap: var(--s2) var(--s4); font-size: var(--text-sm); border-top: 1px solid var(--line); padding-top: var(--s4); }
  .facts dt { color: var(--ink-3); }
  .facts dd { color: var(--ink-2); }
  .creds { list-style: none; display: grid; gap: 4px; }
  .creds li { color: var(--ink); }
  :global(html[lang="ko"]) .facts { grid-template-columns: 56px 1fr; }
</style>
