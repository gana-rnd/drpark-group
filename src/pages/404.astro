---
import Base from '../layouts/Base.astro';
import { getLangFromUrl, useTranslations, localizePath } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Base title="Page not found" description="The page you were looking for does not exist.">
  <section class="container section nf">
    <p class="eyebrow">404</p>
    <h1>{t.notFound.title}</h1>
    <p class="lead">{t.notFound.lead}</p>
    <div class="actions"><a class="btn" href={localizePath('/', lang)}>{t.notFound.home}</a></div>
  </section>
</Base>

<style>
  .nf { min-height: 50vh; }
  .nf h1 { font-size: var(--text-h1); color: var(--ink); letter-spacing: -0.025em; }
  .nf .lead { margin-top: var(--s4); }
  .actions { display: flex; align-items: center; gap: var(--s6); margin-top: var(--s7); flex-wrap: wrap; }
</style>
